#!/bin/bash
#
# cloud - a minimal "cloud" built with bash, qemu-img and virsh.
#
# Demo code: kept as simple as possible, with almost no error handling.

ROOT=/root/cloud
POOL=/storage/nfs

CONFIG_DIR=$ROOT/config
FLAVORS_DIR=$ROOT/flavors
CI_DIR=$ROOT/ci
IMG_DIR=$POOL/images

debug() { [[ -n "$DEBUG" ]] && echo "DEBUG: $*" >&2; }
error() { echo "ERROR: $*" >&2; }


##############################################
# Configuration
##############################################

# Load vms/<name>/CONFIG and set VM_CFG_DIR, VM_NAME and VM_HOME
read_vm_config()
{
	local vm_name="$1"

	VM_CFG_DIR="$ROOT/vms/$vm_name"

	if [[ ! -d "$VM_CFG_DIR" ]]; then
		error "No configuration directory for $vm_name"
		exit 1
	fi
	if [[ ! -f "$VM_CFG_DIR/CONFIG" ]]; then
		error "No configuration file $VM_CFG_DIR/CONFIG"
		exit 1
	fi

	source "$VM_CFG_DIR/CONFIG"

	VM_NAME="${VM_NAME:-$vm_name}"
	VM_HOME="$POOL/vms/$VM_NAME"
}


# Run virsh against the libvirt daemon on a remote host
virsh_on()
{
	local host="$1"
	shift
	virsh -c "qemu+ssh://$host/system" "$@"
}


##############################################
# Disks
##############################################

clone_image()
{
	local image="$1"
	local dest="$2"
	local size="$3"

	if [[ ! -f "$image" ]]; then
		error "Source image $image not found"
		exit 1
	fi

	debug "Cloning $image to $dest with size $size GB"
	qemu-img create -f qcow2 -b "$image" -F qcow2 "$dest" "${size}G" >&2
}

create_empty_disk()
{
	local dest="$1"
	local size="$2"

	debug "Creating empty disk image $dest of size $size GB"
	qemu-img create -f qcow2 "$dest" "${size}G" >&2
}

create_disks()
{
	local i disk size img

	for i in "${!VM_DISK_SIZE[@]}"; do
		disk="$VM_HOME/disk_${i}.img"
		size="${VM_DISK_SIZE[$i]}"
		img="${VM_DISK_IMAGE[$i]}"

		# don't destroy existing disks
		if [[ -f "$disk" ]]; then
			debug "Disk image $disk already exists. Skipping it."
			continue
		fi

		if [[ -n "$img" ]]; then
			clone_image "$IMG_DIR/$img" "$disk" "$size"
		else
			create_empty_disk "$disk" "$size"
		fi
	done
}


##############################################
# Domain XML
##############################################

# Print one <disk> element per disk
include_disks()
{
	local template="$FLAVORS_DIR/$VM_FLAVOR/disk.tmpl"
	local disk_names=(vd{a..z})
	local i

	# flavors with fixed disks in domain.xml have no disk template
	[[ -f "$template" ]] || return

	export VM_DISK_PATH VM_DISK_DEV
	for i in "${!VM_DISK_SIZE[@]}"; do
		VM_DISK_PATH="$VM_HOME/disk_${i}.img"
		VM_DISK_DEV="${disk_names[$i]}"
		envsubst < "$template"
	done
}

# Print one <interface> element per network
include_interfaces()
{
	local template="$FLAVORS_DIR/$VM_FLAVOR/interface.tmpl"

	# flavors with fixed interfaces in domain.xml have no interface template
	[[ -f "$template" ]] || return

	export VM_NET
	for VM_NET in "${VM_NETS[@]}"; do
		envsubst < "$template"
	done
}

create_vm()
{
	local template="$FLAVORS_DIR/$VM_FLAVOR/domain.xml"

	# Generate a UUID once and save it, so the VM keeps it on every start
	if [[ -z "$VM_UUID" ]]; then
		VM_UUID=$(uuidgen)
		echo "VM_UUID=$VM_UUID" >> "$VM_CFG_DIR/CONFIG"
	fi

	mkdir -p "$VM_HOME"
	create_disks

	# flavors with a single fixed disk use VM_DISK_PATH in domain.xml
	VM_DISK_PATH="$VM_HOME/disk_0.img"

	INCLUDE_DISKS=$(include_disks)
	INCLUDE_INTERFACES=$(include_interfaces)

	export "${!VM_@}" "${!INCLUDE_@}"
	debug "Creating domain XML $VM_CFG_DIR/domain.xml"
	envsubst < "$template" > "$VM_CFG_DIR/domain.xml"
}


##############################################
# Hosts
##############################################

load_hosts()
{
	mapfile -t KVM_HOSTS < "$CONFIG_DIR/kvm-hosts"
}

# Print the host where the VM is running
find_vm()
{
	local vm_name="$1"
	local host

	for host in "${KVM_HOSTS[@]}"; do
		if virsh_on "$host" list --name --state-running | grep -qFx "$vm_name"; then
			echo "$host"
			return
		fi
	done
}

# Print the host with the most free memory
select_host()
{
	local host kb

	for host in "${KVM_HOSTS[@]}"; do
		# "virsh freecell" prints: Total: 15372700 KiB
		kb=$(virsh_on "$host" freecell | awk '{print $2}')
		echo "$kb $host"
	done | sort -rn | head -1 | cut -d ' ' -f 2
}


##############################################
# VM operations
##############################################

# Start the VM on the given host, or on the host with the most free memory
start_vm()
{
	local vm_name="$1"
	local host="$2"
	local domain="$VM_CFG_DIR/domain.xml"
	local running_on

	if [[ ! -f "$domain" ]]; then
		error "Domain XML $domain not found. Run '$(basename "$0") create' first."
		return 1
	fi

	running_on=$(find_vm "$vm_name")
	if [[ -n "$running_on" ]]; then
		error "VM $vm_name is already running on host $running_on"
		return 1
	fi

	if [[ -z "$host" ]]; then
		host=$(select_host)
	fi
	debug "Selected host $host. Starting VM $vm_name."
	virsh_on "$host" create "$domain"
}

# action: "destroy" powers off the VM, "shutdown" asks the guest OS to stop
stop_vm()
{
	local vm_name="$1"
	local action="${2:-destroy}"
	local host

	host=$(find_vm "$vm_name")
	if [[ -z "$host" ]]; then
		error "VM $vm_name not found running on any host"
		return 1
	fi

	debug "VM $vm_name found on host $host. Running $action."
	virsh_on "$host" "$action" "$vm_name"
}

# Live migrate a running VM to another host. The disks are on shared
# storage, so only the memory and device state are copied.
migrate_vm()
{
	local vm_name="$1"
	local dest="$2"
	local host

	host=$(find_vm "$vm_name")
	if [[ -z "$host" ]]; then
		error "VM $vm_name not found running on any host"
		return 1
	fi

	debug "VM $vm_name found on host $host. Migrating to $dest."
	virsh_on "$host" migrate --live "$vm_name" "qemu+ssh://$dest/system"
}

# Connect to the VM's serial console. Press Ctrl+] to exit.
console_vm()
{
	local vm_name="$1"
	local host

	host=$(find_vm "$vm_name")
	if [[ -z "$host" ]]; then
		error "VM $vm_name not found running on any host"
		return 1
	fi

	debug "VM $vm_name found on host $host. Connecting to its console."
	virsh_on "$host" console "$vm_name"
}

list_vms()
{
	local host vm

	for host in "${KVM_HOSTS[@]}"; do
		while read -r vm; do
			[[ -z "$vm" ]] && continue
			printf '%s\t%s\n' "$host" "$vm"
		done <<< "$(virsh_on "$host" list --name --state-running)"
	done
}


##############################################
# Main
##############################################

usage()
{
	cat >&2 <<-EOF
	Usage: $(basename "$0") <command> [args]

	Commands:
	  create   <vm_name>          Create disks and domain XML from the VM's CONFIG
	  start    <vm_name> [host]   Start the VM on the given host, or on the
	                              host with the most free memory
	  stop     <vm_name>          Power off the VM on whichever host it is running on
	  shutdown <vm_name>          Ask the guest OS to shut down the VM
	  migrate  <vm_name> <host>   Live migrate the VM to the given host
	  console  <vm_name>          Connect to the VM's serial console (Ctrl+] exits)
	  list                        List running VMs on all hosts
	  help                        Show this message

	Set DEBUG=1 for verbose output.
	EOF
}

require_vm_name()
{
	if [[ -z "$1" ]]; then
		error "Missing VM name"
		usage
		exit 1
	fi
}

main()
{
	local cmd="$1"

	if [[ -z "$cmd" ]]; then
		usage
		exit 1
	fi
	shift

	case "$cmd" in
		create)
			require_vm_name "$1"
			read_vm_config "$1"
			create_vm
			;;
		start)
			require_vm_name "$1"
			load_hosts
			read_vm_config "$1"
			start_vm "$VM_NAME" "$2"
			;;
		stop)
			require_vm_name "$1"
			load_hosts
			read_vm_config "$1"
			stop_vm "$VM_NAME"
			;;
		shutdown)
			require_vm_name "$1"
			load_hosts
			read_vm_config "$1"
			stop_vm "$VM_NAME" shutdown
			;;
		migrate)
			require_vm_name "$1"
			if [[ -z "$2" ]]; then
				error "Missing host"
				usage
				exit 1
			fi
			load_hosts
			read_vm_config "$1"
			migrate_vm "$VM_NAME" "$2"
			;;
		console)
			require_vm_name "$1"
			load_hosts
			read_vm_config "$1"
			console_vm "$VM_NAME"
			;;
		list)
			load_hosts
			list_vms
			;;
		help|-h|--help)
			usage
			;;
		*)
			error "Unknown command: $cmd"
			usage
			exit 1
			;;
	esac
}

main "$@"
